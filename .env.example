# Copy this file to .env and fill in real values.
# Never commit .env to git.

# Google Maps API key — get from GCP Console
# Must have Android app restriction: package com.ao18277.nameplacemobile + release SHA-1
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Supabase (reserved for v2 cloud sync — not used in v1 local-only build)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
